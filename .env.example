
## Required for Cognito Authentication
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=

## FastAPI Backend URL
NEXT_PUBLIC_GRAPHQL_API_URL=

# Locale cookie name for storing user's preferred locale
NEXT_PUBLIC_LOCALE_COOKIE_NAME=

# S3 Storage Configuration
NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_REGION=

# File upload size limit in MB (default: 10)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10

# Idle timeout in minutes before auto-logout (default: 120 = 2 hours)
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=120